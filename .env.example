CARD_API_KEY=your_card_api_key_here
# For production / CI builds, pass --dart-define=API_URL=https://thesmartcards.com
# or configure API_URL in this .env file.
API_URL=https://thesmartcards.com
SHARED_UPLOADS_URL=https://thesmartcards.com/shared-uploads
USE_LOCAL_BACKEND=false
USE_PHYSICAL_DEVICE_FOR_LOCAL=false
LOCAL_PHYSICAL_IP=192.168.1.1
